;; 3CP Block Structure (CBOR)
;; CDDL — RFC 8610
;; Integer keys in canonical (ascending) order.

block = {
  0 => uint64,                     ; Index
  1 => bytes .size 32,             ; PrevHash (BLAKE3-256)
  2 => bytes .size 32,             ; StateRoot (SMT root)
  3 => bytes .size 16,             ; Proposer (RootID)
  4 => [3 * bytes],                ; Triad (reserved)
  5 => [* provenance-entry],       ; Anchored entries
  6 => float64,                    ; Lambda1 (Laplacian eigenvalue)
  7 => int64,                      ; Timestamp (UnixNano)
  8 => null,                       ; RESERVED in ProtocolVersion == 2 (was Sigs in v1.0)
  9 => [* validator-info],         ; Validators (canonical validator set, see §7.1)
  10 => quorum-config,             ; Quorum
  11 => bytes .size 32,            ; BlockHash (SHA-256)

  ;; v2.0 fields
  12 => uint16,                     ; ProtocolVersion (default: 2)
  13 => bytes,                      ; PrepareSigsBitmap (bitfield, N bits)
  14 => [* bytes .size 3309],       ; PrepareSigsPayload (only active signers)
  15 => bytes .size 3309,           ; CommitSig (leader's commit signature)
  16 => [* tstr],                   ; ExternalAnchors (URIs/CIDs of publication)
  17 => uint64,                     ; KeyRotationEpoch (reference cycle for active keys)
  18 => bytes .size 32,             ; LegacyAnchor (H(B_final v1.0); genesis only, §16)
  19 => {* tstr => bytes},          ; Metadata (e.g. "3cp:degraded-block", §5.5)
}

validator-info = {
  0 => bytes .size 16,             ; ValidatorID (RootID)
  1 => bytes .size 1952,           ; Dilithium3PK
  2 => bytes .size 32,             ; VRFPK
  3 => bytes .size 32,             ; ContractHash (optional)
}

provenance-entry = {
  0 => bytes .size 32,             ; Hash (anchored artifact hash)
  1 => bytes,                      ; Submitter (RootID or caller)
  2 => int64,                      ; Timestamp (UnixNano)
  3 => tstr,                       ; Label
  ? 4 => bytes,                    ; Approver (RootID)
  ? 5 => bytes .size 32,           ; Reference (related entry hash)
  ? 6 => bytes .size 3309,         ; Signature (Dilithium3)
  ? 7 => bytes .size 32,           ; MandateRef (hash of MandateEntry, §4.4)
}

mandate-entry = {
  0 => bytes .size 32,             ; MandateID (BLAKE3-256 of canonical CBOR excluding signature)
  1 => bytes .size 16,             ; Authority (RootID)
  2 => uint64,                     ; Version
  3 => bytes .size 32,             ; PrevVersion (zeros for first version)
  4 => int64,                      ; ValidFrom (UnixNano)
  5 => int64,                      ; ValidUntil (UnixNano; 0 = never expires)
  6 => bytes .size 32,             ; Supersedes (zeros if no prior mandate)
  7 => [* rule],                   ; Rules
  8 => bytes .size 32,             ; PolicyHash
  ? 9 => tstr,                     ; PolicyURI
  10 => bytes .size 3309,          ; Signature (Dilithium3 from Authority)
}

rule = {
  0 => tstr,                       ; EventClass
  1 => tstr,                       ; Description
  2 => float64,                    ; SeverityMin (0.0 = any)
  3 => float64,                    ; SeverityMax (10.0 = any)
  4 => uint,                       ; AssetCriticalityMin (1-5)
  5 => [* tstr],                   ; RegulatoryScope
  6 => bool,                       ; Mandatory
  7 => [* tstr],                   ; RequiredFields
  8 => uint64,                     ; MaxDeferralSec
}

quorum-config = {
  0 => int,                        ; TotalValidators
  1 => int,                        ; RequiredSigs
}

uid0-identity = {
  0 => bytes .size 16,             ; RootID
  1 => bytes .size 16,             ; FEntropy
  ? 2 => bytes,                    ; GenesisHash
  ? 3 => [* bytes],                ; FounderMerkleProofs
  ? 4 => bytes,                    ; SigRecovery
  ? 5 => bytes,                    ; SigUpdate
  ? 6 => bytes,                    ; SigAudit
  ? 7 => uint64,                   ; ReputationSum
  ? 8 => tstr,                     ; SiderealTime
  ? 9 => uint64,                   ; CycleIndex
  ? 10 => int64,                   ; GeneratedAt
  ? 11 => bytes .size 32,          ; MerkleRoot
  ? 12 => [* bytes],               ; MerkleProof
  ? 13 => bool,                    ; Simulated
  14 => bytes .size 32,            ; FinalDigest
  15 => bytes .size 1952,          ; PublicKey (Dilithium3)
  16 => bytes,                     ; SecretKey (MUST NOT be transmitted)
  ? 17 => bytes,                   ; ContractHash
  18 => bytes .size 32,            ; VRFPublicKey
  19 => bytes .size 32,            ; VRFSecretKey (MUST NOT be transmitted)
}