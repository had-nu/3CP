;; 3CP Block Structure (CBOR) — protocol v3.0
;; CDDL — RFC 8610
;; Integer keys in canonical (ascending) order.
;; Signature 3309 B = ML-DSA-65 (FIPS 204 Table 2); public key 1952 B.
;; Canonical encoding: RFC 8949 §4.2.1 (shortest round-trip floats; no NaN/Inf).
;; Block layout follows upstream PR #2 (72a5e4b/#2) — preserved here.

validator-info = {
  0 => bytes .size 16,             ; ValidatorID (RootID)
  1 => bytes .size 1952,           ; ML-DSA-65 public key
  2 => bytes .size 32,             ; VRF public key (Ristretto255 point)
  3 => bytes .size 32,             ; ContractHash (zeros if absent)
}

block = {
  0  => uint64,                    ; Index
  1  => bytes .size 32,            ; PrevHash (BLAKE3-256 of previous BlockHash)
  2  => bytes .size 32,            ; StateRoot (BLAKE3-256 SMT root)
  3  => bytes .size 16,            ; Proposer (RootID)
  ? 4 => [3 * bytes],              ; Triad (reserved; omitted in v3.0)
  5  => [* provenance-entry],      ; Anchored entries
  6  => float,                     ; Lambda1 (shortest round-trip)
  7  => int64,                     ; Timestamp (UnixNano)
  ? 8 => null,                     ; RESERVED in ProtocolVersion == 3 (was Sigs in v1.0)
  9  => [* validator-info],        ; Validators (canonical validator set, see §7.1)
  10 => quorum-config,             ; Quorum
  11 => bytes .size 32,            ; BlockHash (SHA-256, domain-separated — §5.5)
  12 => uint16,                    ; ProtocolVersion (== 3 in v3.0)
  13 => bytes,                     ; PrepareSigsBitmap (MSB-first bits; high bits zero)
  14 => [* bytes .size 3309],      ; PrepareSigsPayload (active signers, index order)
  15 => bytes .size 3309,          ; CommitSig (leader signature over B_final)
  16 => [* tstr],                  ; ExternalAnchors (publication URIs/CIDs)
  17 => uint64,                    ; KeyRotationEpoch (reference cycle for active keys)
  18 => bytes .size 32,            ; LegacyAnchor (genesis only; zeros otherwise)
  19 => {* tstr => bytes},         ; Metadata (e.g. "3cp:degraded-block", §6.5)
}
; Keys > 19 MUST be ignored on decode (forward compatibility, §5.3).

provenance-entry = {
  0  => bytes .size 32,            ; Hash (anchored artifact hash)
  1  => bytes,                     ; Submitter (RootID or caller)
  2  => int64,                     ; Timestamp (UnixNano)
  3  => tstr,                      ; Label
  ? 4 => bytes,                    ; Approver (RootID)
  ? 5 => bytes .size 32,           ; Reference (related entry hash)
  ? 6 => bytes .size 3309,         ; Signature (ML-DSA-65 over "3CP-ENTRY-v3" payload)
  ? 7 => bytes .size 32,           ; MandateRef (hash of MandateEntry, §13)
}

quorum-config = {
  0 => uint,                       ; TotalValidators
  1 => uint,                       ; RequiredSigs
}

uid0-identity = {
  0  => bytes .size 16,            ; RootID
  1  => bytes .size 32,            ; EntropySource (32 bytes from OS CSPRNG, §11.2)
  ? 2 => bytes,                    ; GenesisHash
  ? 3 => [* bytes],                ; FounderMerkleProofs
  ? 4 => bytes,                    ; SigRecovery
  ? 5 => bytes,                    ; SigUpdate
  ? 6 => bytes,                    ; SigAudit
  ? 7 => uint64,                   ; ReputationSum
  ? 8 => tstr,                     ; SiderealTime
  ? 9 => uint64,                   ; CycleIndex
  ? 10 => int64,                   ; GeneratedAt
  ? 11 => bytes .size 32,          ; MerkleRoot
  ? 12 => [* bytes],               ; MerkleProof
  ? 13 => bool,                    ; Simulated
  14 => bytes .size 32,            ; FinalDigest
  15 => bytes .size 1952,          ; ML-DSA-65 public key
  16 => bytes,                     ; SecretKey (MUST NOT be exported or transmitted)
  ? 17 => bytes,                   ; ContractHash
  18 => bytes .size 32,            ; VRFPublicKey (Ristretto255)
  19 => bytes .size 32,            ; VRFSecretKey (MUST NOT be exported or transmitted)
}