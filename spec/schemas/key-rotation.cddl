;; 3CP Key Rotation Entry v3.0
;; CDDL — RFC 8610
;; EventClass: "3cp:key-rotation:v1"
;; Signature 3309 B = ML-DSA-65 (FIPS 204); public key 1952 B.
;; Hash = BLAKE3-256(canonical CBOR of fields 1,2,3,20,21,22,23).
;; SignatureOld and SignatureNew are ML-DSA-65 signatures (empty context) over
;; the identical payload "3CP-KEYROT-v3" || Hash (spec §8.2).

key-rotation-entry = {
    ;; base provenance-entry fields
    0  => bytes .size 32,    ; Hash
    1  => bytes .size 16,    ; Submitter (ValidatorID)
    2  => int64,             ; Timestamp (UnixNano)
    3  => tstr,              ; Label: "3cp:key-rotation:v1"

    ;; rotation-specific fields
    20 => bytes .size 1952,  ; NewPublicKey (ML-DSA-65)
    21 => bytes .size 32,    ; NewVRFPublicKey (Ristretto255 point)
    22 => uint64,            ; EffectiveCycle
    23 => uint64,            ; ExpiryCycle
    24 => bytes .size 3309,  ; SignatureOld (current key)
    25 => bytes .size 3309,  ; SignatureNew (NewPublicKey)
}
