;; 3CP Genesis Block v3.0
;; CDDL — RFC 8610
;; Index 0. Bootstraps the ValidatorSet and the initial Mandate.
;; NetworkID = BLAKE3-256(canonical CBOR of this block with key 11 OMITTED);
;; see spec §11.1 for the normative genesis construction order.

genesis-block = {
    0  => uint64,                ; Index: 0
    1  => bytes .size 32,        ; PrevHash: 32 zero bytes
    2  => bytes .size 32,        ; StateRoot
    3  => bytes .size 16,        ; Proposer (first validator)
    5  => [* provenance-entry],  ; Anchored (must include GenesisMandate)
    6  => float,                 ; Lambda1 (0.0 for genesis)
    7  => int64,                 ; Timestamp (UnixNano)
    8  => null,                  ; Reserved
    9  => [* validator-info],    ; Validators (canonical validator set)
    10 => quorum-config,         ; Quorum
    11 => bytes .size 32,        ; BlockHash (SHA-256, domain-separated)
    12 => uint16,                ; ProtocolVersion: 3
    18 => bytes .size 32,        ; LegacyAnchor (zeros if none)
}

genesis-validator-set = [* validator-info]
