;; 3CP Sparse Merkle Tree Proof — protocol v3.0
;; BLAKE3-256, depth 256. Serialized as 256 x 32 = 8192 bytes.
;;
;; Leaf:  BLAKE3-256("3CP-SMT-LEAF-v3" || key || value)   key, value = 32 bytes
;; Node:  BLAKE3-256("3CP-SMT-NODE-v3" || left || right)  left, right = 32 bytes
;; Empty: BLAKE3-256("3CP-SMT-NODE-v3" || E || E)         E = BLAKE3-256("")
;; Path bit i (0..255) = (key[i/8] >> (i%8)) & 1   (LSB-first)

smt-proof = bytes .size 8192
; Sibling at byte offset depth*32, for depth = 0 (leaf) .. 255 (root)
