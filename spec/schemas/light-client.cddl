;; 3CP Light Client Protocol v3.0
;; CDDL — RFC 8610
;; Request/response types for third-party block and proof verification.

light-client-request = {
    0 => tstr,                      ; Method: GetBlock/StreamBlocks/GetValidatorSet/GetMerkleProof
    ? 1 => uint64,                  ; StartIndex (StreamBlocks)
    ? 2 => uint64,                  ; BlockIndex (GetBlock, GetMerkleProof)
    ? 3 => bytes .size 32,          ; Key (GetMerkleProof)
}

light-client-response = {
    0 => bool,                      ; Success
    1 => block / [* block] / [* validator-info] / smt-proof / null,
    ? 2 => tstr,                    ; Error message (if Success == false)
}

smt-proof = bytes .size 8192        ; 256 x 32-byte sibling hashes, leaf-to-root
